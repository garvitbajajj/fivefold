# --- Supabase: project settings -> API keys ---------------------------------
# Safe in the browser: every table is behind row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SERVER ONLY. Used for one job: recording a payment Stripe has confirmed.
# Never prefix with NEXT_PUBLIC_ — that would ship it to every visitor.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Stripe: dashboard -> Developers -> API keys (test mode) ----------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
# Endpoint URL: https://your-site/api/stripe/webhook
# Events: invoice.paid, customer.subscription.updated,
#         customer.subscription.deleted, checkout.session.completed
#
# Locally, the success page confirms payments without the webhook. To
# exercise renewals and cancellations too, run the Stripe CLI:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# and use the whsec_ it prints.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
