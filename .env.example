# Supabase project settings -> API
# Both values are safe to expose in the browser: every table is protected by
# row level security, and privileged writes happen inside SECURITY DEFINER
# functions. No service-role key is needed anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
